{
  "name": "next-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "plop": "plop",
    "sync": "node scripts/sync-r2-assets.mjs",
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' && yarn format",
    "format": "yarn prettier --write 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test-ui": "vitest --ui",
    "test-update": "vitest --update",
    "test-cov": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "caniuse-lite": "^1.0.30001660",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "github-markdown-css": "^5.4.0",
    "highlight.js": "^11.9.0",
    "marked": "^11.0.0",
    "marked-highlight": "^2.0.8",
    "next": "16.2.9",
    "normalize.css": "^8.0.1",
    "react": "19.2.7",
    "react-aria-components": "^1.18.0",
    "react-dom": "19.2.7",
    "react-scroll": "^1.9.0",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@storybook/addon-coverage": "^3.0.1",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-links": "^10.4.5",
    "@storybook/cli": "^10.4.5",
    "@storybook/nextjs-vite": "^10.4.5",
    "@storybook/react": "^10.4.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-scroll": "^1.8.10",
    "@types/react-transition-group": "^4.4.9",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/next-plugin": "^2.4.6",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-storybook": "^10.4.5",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.6",
    "inquirer": "^11.0.2",
    "jsdom": "^25.0.0",
    "next-router-mock": "^0.9.13",
    "plop": "^4.0.1",
    "prettier": "^3.2.5",
    "storybook": "^10.4.5",
    "stylelint": "^16.2.1",
    "stylelint-config-recess-order": "^5.0.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.1",
    "yarn-audit-fix": "^10.1.1"
